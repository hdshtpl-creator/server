# ---------- Cơ sở dữ liệu ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hdsai
DB_USER=hds
DB_PASSWORD=doi_mat_khau_manh
APP_DB_USER=hds_app
APP_DB_PASSWORD=doi_mat_khau_manh_2

# ---------- Mô hình AI (qua Ollama) ----------
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:14b
EMBED_MODEL=bge-m3
EMBED_DIM=1024
# Sau khoảng này không dùng, Ollama có thể dỡ model khỏi VRAM. Chỉ đặt -1 khi
# đã xác nhận model sinh + bge-m3 cùng nằm vừa GPU/RAM bằng `ollama ps`.
OLLAMA_KEEP_ALIVE=30m

# Tái dùng kết nối PostgreSQL thay vì mở mới nhiều lần cho mỗi câu chat.
DB_POOL_MAX=12
DB_ADMIN_POOL_MAX=4
DB_POOL_TIMEOUT=10
SETTINGS_CACHE_SECONDS=2

# ---------- GỌI MODEL QUA API NGOÀI (tuỳ chọn) ----------
# Đặt khoá ở đây MỚI CHỈ LÀ ĐIỀU KIỆN CẦN: nhánh này còn phải được admin bật
# trên web (Cài đặt AI → "API ngoài — bật gọi model qua API"). Mặc định TẮT vì
# bật là dữ liệu câu hỏi rời khỏi máy chủ HDS và mỗi lượt hỏi tốn tiền.
#
# Anthropic (Claude). Giá tham khảo USD/1 triệu token (vào/ra):
#   claude-haiku-4-5  1 / 5   — rẻ nhất, cửa sổ 200K
#   claude-sonnet-5   2 / 10  — cân bằng cho việc pháp lý, cửa sổ 1M
#   claude-opus-5     5 / 25  — mạnh nhất, cửa sổ 1M
ANTHROPIC_API_KEY=
CLAUDE_MODELS=claude-sonnet-5,claude-opus-5,claude-haiku-4-5

# Endpoint TƯƠNG THÍCH OpenAI — một cấu hình cho cả nhóm nói chung giao thức:
#   Qwen (DashScope): https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek        : https://api.deepseek.com/v1
#   OpenRouter      : https://openrouter.ai/api/v1
#   vLLM tự dựng    : http://<máy>:8000/v1
# COMPAT_MODELS là danh sách hiện trong bộ chọn, phân tách bằng dấu phẩy.
COMPAT_BASE_URL=https://api.openai.com/v1
COMPAT_API_KEY=
COMPAT_MODELS=

# Hai biến cũ, giữ cho tương thích: nếu không đặt COMPAT_* thì dùng chúng.
# OPENAI_API_KEY cũng là khoá cho tính năng "ChatGPT soát câu trả lời" và
# "Xem câu trả lời khác" (04/10/2026) — bật/tắt, chọn model trong Cài đặt AI.
# Điền xong phải khởi động lại backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- Google Drive (giai đoạn sau) ----------
DRIVE_FOLDER_ID=
DRIVE_SA_FILE=credentials/service-account.json
# Mặc định file Drive mới CHỜ DUYỆT. Chỉ bật sau khi đã kiểm tra dashboard lỗi/cảnh báo.
AUTO_LEARN_AUTO_APPROVE=0
# Giới hạn an toàn; có thể tăng sau khi đo RAM và thời gian xử lý thực tế.
DRIVE_MAX_DOWNLOAD_BYTES=104857600
INGEST_MAX_SOURCE_BYTES=104857600
INGEST_MAX_SPREADSHEET_ROWS=20000
INGEST_MAX_SPREADSHEET_COLUMNS=256
INGEST_MAX_EXTRACTED_CHARS=3000000
INGEST_MAX_CELL_CHARS=4000
INGEST_MAX_OCR_PAGES=200
# --- Chat luong OCR ban scan -------------------------------------------
# Bo doc chu: auto = dung PaddleOCR neu da cai, khong thi tesseract.
# Cai PaddleOCR: pip install paddleocr paddlepaddle
# Ep ve ban cu khi can: INGEST_OCR_ENGINE=tesseract
INGEST_OCR_ENGINE=auto
# Nan trang nghieng (ban scan dat tay thuong lech 1-3 do).
INGEST_OCR_DESKEW=1
INGEST_OCR_DESKEW_MAX_DEG=3
INGEST_OCR_DESKEW_STEP=0.25
# Nhi phan hoa theo vung — cuu ban scan giay ngang vang / anh sang khong deu.
INGEST_OCR_BINARIZE=1
INGEST_OCR_BINARIZE_RADIUS=15
INGEST_OCR_BINARIZE_BIAS=10
INGEST_MAX_ARCHIVE_UNCOMPRESSED_BYTES=262144000

# ---------- Thư mục ----------
DATA_RAW=./data/raw
DATA_WORK=./data/work
# KHO TÀI LIỆU trên máy chủ — thư mục bộ quét (app/local_learn.py) đọc, và là
# thư mục chia sẻ cho nhân viên thả file (Samba/ổ mạng). Bỏ trống = dùng
# DATA_RAW, đúng chỗ cây thư mục đồng bộ từ Drive trước đây đang nằm, nên
# chuyển sang chế độ local không phải chép lại gì.
DATA_LIB=./data/raw

# ---------- Đăng nhập (JWT) ----------
# BẮT BUỘC đổi. Ứng dụng từ chối khởi chạy nếu để nguyên chuỗi mẫu này,
# nếu chuỗi ngắn hơn 32 ký tự, hoặc nếu bỏ trống.
# Sinh khoá: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=doi_chuoi_bi_mat_ngau_nhien_dai_khi_chay_that
TOKEN_HOURS=12
# Van chống dò mật khẩu ở trang đăng nhập: số lần gõ SAI mỗi IP trong cửa sổ
# (giây). Lượt đăng nhập đúng không bị đếm (từ 03/10/2026). 0 = tắt.
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW_SEC=300
# Sơ đồ API (/docs, /redoc, /openapi.json). Mặc định TẮT vì đó là bản đồ mọi
# endpoint cho người lạ dò. Bật 1 tạm thời khi bên tích hợp cần đọc, rồi tắt lại.
API_DOCS=0

# ---------- CORS ----------
# Để TRỐNG khi deploy chung một máy chủ (nginx proxy /api cùng origin).
# Chỉ điền khi giao diện chạy ở origin khác, ví dụ:
#   CORS_ORIGINS=https://app.hdslaw.vn,https://hds-ai.vercel.app
CORS_ORIGINS=

# ---------- Đọc giấy tờ cho web Đăng ký kinh doanh (POST /dkkd/extract) ----------
# Web ĐKKD gửi ảnh CCCD/hộ chiếu/Giấy ĐKDN, máy chủ trả JSON các trường bằng
# model NHÌN ẢNH trên Ollama. Cần GPU: "ollama pull qwen2.5vl:7b" (~6 GB).
# Chi tiết: deploy/DOC_GIAY_TO_DKKD.md
VISION_MODEL=qwen2.5vl:7b
# 0 = CHỈ NẠP KHI DÙNG: dỡ khỏi VRAM ngay sau mỗi lượt đọc (card 16GB không
# chứa cùng lúc qwen3:14b + model thị giác). Đặt 2m nếu card ≥ 24GB và khách
# hay gửi nhiều ảnh liên tiếp.
VISION_KEEP_ALIVE=0
# Ngữ cảnh riêng cho model thị giác — không dùng 32K như chat (KV cache tràn VRAM).
VISION_NUM_CTX=8192
# Thu nhỏ ảnh về cạnh dài này trước khi gửi model (đủ đọc số nhỏ, nhanh hơn nhiều).
VISION_MAX_EDGE=1600
# Origin của web ĐKKD được phép gọi (scheme://host, phân tách dấu phẩy).
# TRỐNG = endpoint tắt. Tự động được cộng vào CORS, không phải khai lại ở trên.
#   DKKD_ALLOWED_ORIGINS=https://dkkd.hdslaw.vn,https://dkkd-hds.vercel.app
DKKD_ALLOWED_ORIGINS=
# Van theo IP: số lượt đọc / cửa sổ giây. Mỗi lượt = một lần chạy GPU.
DKKD_RATE_MAX=40
DKKD_RATE_WINDOW_SEC=900
