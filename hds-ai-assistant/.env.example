# Tệp mẫu — sao chép thành .env rồi điền giá trị thật.
# KHÔNG commit tệp .env lên GitHub (.gitignore đã chặn sẵn).

# ------------------------------------------------------------------
# Frontend (Vite)
# ------------------------------------------------------------------
# Địa chỉ backend FastAPI của hds-ai. Có thể đổi lúc chạy trong hộp thoại
# "Cấu hình kết nối" trên thanh tiêu đề.
VITE_API_BASE_URL=http://localhost:8000
# Chỉ bật trên máy demo/dev. Production phải để false để không thể nhầm dữ liệu mẫu là thật.
VITE_ENABLE_MOCK_MODE=false

# ------------------------------------------------------------------
# Hạ tầng nội bộ HDS (dùng cho các script Python trong thư mục backend/)
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hds_legal_db

# Tài khoản chủ CSDL — bỏ qua RLS, chỉ dùng để nạp dữ liệu và migration
DB_USER_ADMIN=hds
DB_PASS_ADMIN=thay-bang-mat-khau-that

# Tài khoản ứng dụng — bị ràng buộc bởi Row Level Security
DB_USER_APP=hds_app
DB_PASS_APP=thay-bang-mat-khau-that

# Dịch vụ embedding Ollama chạy nội bộ (bge-m3 / Qwen3)
OLLAMA_URL=http://localhost:11434
